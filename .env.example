# Copy to .env and fill in. .env is gitignored — never commit real values.

# Azure DevOps PAT for the azure-devops MCP server (Work Items read/write scope is enough)
ADO_PAT=your-azure-devops-pat

# The azure-devops MCP server reads this name specifically — leave as-is.
PERSONAL_ACCESS_TOKEN=${ADO_PAT}

# SQL Server container (docker-compose.yml) — local dev only, not for production
MSSQL_SA_PASSWORD=your-local-dev-password

# Read by the API via DotNetEnv; overrides appsettings' DefaultConnection so it points at the container above
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=FamilyJournal;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True;

test