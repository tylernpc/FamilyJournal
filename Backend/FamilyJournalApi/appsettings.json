{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "FamilyJournal",
    "Audience": "FamilyJournal",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Media": {
    "RootPath": "App_Data/media",
    "MaxUploadBytes": 15728640,
    "UrlLifetimeHours": 6
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=FamilyJournal;Trusted_Connection=True;TrustServerCertificate=True;"
  }
}
